# =============================================================================
# crypto_bot .env.example
# Copy to ".env" and fill in. NEVER commit the real ".env" file.
# =============================================================================

# --- Operating mode -----------------------------------------------------
# BACKTEST | PAPER | LIVE.  Always start in PAPER. LIVE must be opted into
# explicitly and never becomes the default.
MODE=PAPER

# Extra safety belt independent of MODE: if true, no order is ever sent to
# Binance (even when MODE=LIVE) - useful for a "shadow" dry run against real
# market data. PAPER/BACKTEST ignore this flag (they never hit real orders).
DRY_RUN=true

# --- Binance API ----------------------------------------------------------
# API key must have Spot & Margin Trading -> "Enable Spot & Margin Trading"
# permission ONLY. Withdrawal permission must be DISABLED on the key.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# --- Telegram control -------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Only this numeric Telegram user id may issue commands to the bot.
TELEGRAM_ALLOWED_USER_ID=

# --- Database ---------------------------------------------------------------
DATABASE_URL=sqlite:///./data/crypto_bot.db

# --- Position sizing ----------------------------------------------------
INITIAL_ORDER_USDT=100
MAX_POSITION_USDT=300
MAX_OPEN_POSITIONS=3

# --- Take profit --------------------------------------------------------
TARGET_PROFIT_PERCENT=10
USE_TRAILING_AFTER_TP=false
TRAILING_PARTIAL_CLOSE_FRACTION=0.6
TRAILING_DISTANCE_PERCENT=2.5

# --- DCA (controlled averaging, NOT martingale) --------------------------
MAX_DCA_COUNT=3
DCA_LEVEL_1=-3
DCA_LEVEL_2=-6
DCA_LEVEL_3=-10
DCA_SIZE_1_USDT=50
DCA_SIZE_2_USDT=75
DCA_SIZE_3_USDT=75
MIN_DCA_SCORE=65

# --- Signal scoring -------------------------------------------------------
MIN_BUY_SCORE=75
MIN_CONFIRMED_SIGNALS=5
MIN_CONFIRMATION_CATEGORIES=4

# --- Fees / slippage assumptions (used for net-profit target & backtest) --
TAKER_FEE_RATE=0.001
MAKER_FEE_RATE=0.001
EXPECTED_SLIPPAGE_PERCENT=0.05

# --- Order execution ------------------------------------------------------
# How long a LIMIT entry is allowed to rest unfilled before it gets cancelled.
LIMIT_ORDER_TIMEOUT_SECONDS=90

# --- Risk management --------------------------------------------------------
MAX_TOTAL_EXPOSURE_PERCENT=35
MAX_DAILY_NEW_CAPITAL_USDT=500
MAX_CONSECUTIVE_BAD_TRADES=3
MARKET_CRASH_PAUSE=true
EMERGENCY_AUTO_SELL=false

# --- BTC / market regime filter ---------------------------------------------
BTC_MARKET_FILTER=true

# --- Universe / liquidity filters -------------------------------------------
MIN_QUOTE_VOLUME_24H_USDT=5000000
MAX_SPREAD_PERCENT=0.5
MIN_LISTING_AGE_DAYS=60
SCANNER_TOP_N=25
SCANNER_INTERVAL_MINUTES=15

# --- News analysis ------------------------------------------------------
NEWS_ENABLED=true
NEWS_REFRESH_MINUTES=10
NEWS_BLOCK_SCORE_THRESHOLD=-50
CRYPTOPANIC_API_TOKEN=

# --- Paper trading ------------------------------------------------------
PAPER_STARTING_BALANCE_USDT=10000

# --- Logging / health -----------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
MARKET_DATA_STALE_SECONDS=180

# --- Daily report ---------------------------------------------------------
DAILY_REPORT_HOUR_UTC=21
