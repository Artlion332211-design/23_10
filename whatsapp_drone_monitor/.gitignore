# Реальний конфіг містить назви чатів підрозділу — не для git.
config.yaml

# Профіль Chrome = активна сесія WhatsApp Web (рівнозначно паролю від акаунта).
chrome_profile/

# Ключ сервісного акаунта Google — повний доступ на запис до таблиці.
credentials.json

# Локальний стан і логи — генеруються під час роботи бота.
state.json
*.log

__pycache__/
*.pyc
